# ==============================================================
# Frontend (Vite) — Variables de build
# Copiar como frontend/.env.production.local antes de ejecutar
# `bash build-frontend.sh`. Vite las incrusta en el bundle, asi
# que SOLO deben contener valores publicos.
# ==============================================================

# Proxy de la API durante `npm run dev`.
VITE_API_URL=http://localhost:8000

VITE_APP_NAME="Cronos POS"

# --- Laravel Reverb (WebSockets) ---
VITE_REVERB_APP_KEY=cronos-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ==============================================================
# FASE 9 — Cloudflare Turnstile (anti-bots del login)
# --------------------------------------------------------------
# Site key PUBLICA. Debe coincidir con TURNSTILE_SITE_KEY del
# backend, cuya TURNSTILE_SECRET_KEY valida el token server-side.
#
# ATENCION al desalineamiento: si el backend tiene el secreto
# configurado y este build NO lleva site key, el frontend no
# enviara token y el backend rechazara TODOS los logins con
# ERR_AUTH_CAPTCHA_REQUIRED. Vacio en ambos lados = escudo
# desactivado (valido para desarrollo local).
# ==============================================================
VITE_TURNSTILE_SITE_KEY=
