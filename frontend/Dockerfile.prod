# ==============================================================
# Cronos POS — Frontend Production Dockerfile
# Etapa unica: Nginx Alpine sirviendo el build pre-compilado.
# El bundle de Vite se genera FUERA del Droplet (maquina del
# desarrollador) y se versiona en frontend/dist/ — este Dockerfile
# NO ejecuta Node.js, npm install ni npm run build.
# Build context: monorepo root (.)
# ==============================================================

FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY frontend/dist/ /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
