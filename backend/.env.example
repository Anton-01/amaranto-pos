APP_NAME="Cronos POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: use service name 'postgres'. Local: use 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cronos_pos
DB_USERNAME=cronos
DB_PASSWORD=cronos_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Docker: use service name 'redis'. Local: use 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSockets)
REVERB_APP_ID=cronos-local
REVERB_APP_KEY=cronos-reverb-key
REVERB_APP_SECRET=cronos-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cronos.pos"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# QZ Tray — Impresión Directa vía WebSocket (Cliente → Ticketera)
# ==========================================================================
# La impresión ahora se procesa del lado del cliente con QZ Tray.
# El backend solo genera comandos ESC/POS en Base64 y los retorna en la API.
# La firma digital se usa para suprimir alertas de seguridad de QZ Tray.
# ==========================================================================
QZ_PRIVATE_KEY_PATH=storage/app/certs/private-key.pem
QZ_CERTIFICATE_PATH=storage/app/certs/digital-certificate.txt

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ==========================================================================
# FASE 9 — Escudo de Seguridad y Throttling
# ==========================================================================

# --- Rate Limiting -------------------------------------------------------
# Escudo global de la API: peticiones por minuto y por usuario/IP.
THROTTLE_API_MAX_ATTEMPTS=100
# Escudo de login: intentos FALLIDOS tolerados por ventana (email + IP).
THROTTLE_LOGIN_MAX_ATTEMPTS=5
# Duracion de la ventana de conteo, en segundos.
THROTTLE_LOGIN_WINDOW=60
# Bloqueo aplicado al desbordar la ventana, en segundos (15 minutos).
THROTTLE_LOGIN_LOCKOUT=900

# --- Cabeceras de Seguridad ----------------------------------------------
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
# En local conviene report_only mientras se calibra la politica.
SECURITY_CSP_REPORT_ONLY=false
# HSTS se omite automaticamente sobre http://. Forzarlo solo tras TLS.
SECURITY_HSTS_FORCE=false
SECURITY_HSTS_MAX_AGE=31536000
# Origenes extra (separados por espacio) si se suma un CDN o un agente nuevo.
SECURITY_CSP_EXTRA_SCRIPT_SRC=
SECURITY_CSP_EXTRA_CONNECT_SRC=
SECURITY_CSP_EXTRA_IMG_SRC=

# --- Cloudflare Turnstile (anti-bots del login) --------------------------
# Sin TURNSTILE_SECRET_KEY el escudo queda inactivo y el login opera solo
# con throttling. Llaves: https://dash.cloudflare.com > Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5
# false = si Cloudflare no responde, nadie entra (recomendado en un POS).
TURNSTILE_FAIL_OPEN=false

# Site key publica inyectada en el build de Vite (debe igualar TURNSTILE_SITE_KEY).
VITE_TURNSTILE_SITE_KEY=
