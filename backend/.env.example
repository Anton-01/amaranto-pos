APP_NAME="Cronos POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: use service name 'postgres'. Local: use 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cronos_pos
DB_USERNAME=cronos
DB_PASSWORD=cronos_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Docker: use service name 'redis'. Local: use 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSockets)
REVERB_APP_ID=cronos-local
REVERB_APP_KEY=cronos-reverb-key
REVERB_APP_SECRET=cronos-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cronos.pos"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# ESC/POS Thermal Printer (58mm) — Configuración Híbrida Multi-Entorno
# ==========================================================================
# Valores soportados para PRINTER_CONNECTION_TYPE:
#   windows_share | smb    → WindowsPrintConnector (Docker en Windows, USB compartido via SMB)
#   linux_file    | usb    → FilePrintConnector    (Producción Linux, USB directo /dev/usb/lp0)
#   network                → NetworkPrintConnector  (Ticketera Ethernet/Wi-Fi por IP:Puerto)
# ==========================================================================

# =========================================================================
# OPCIÓN A: DESARROLLO EN WINDOWS (TICKETERA USB COMPARTIDA VIA SMB)
# Requiere: Compartir la impresora en Windows y acceder desde Docker
# =========================================================================
PRINTER_CONNECTION_TYPE=windows_share
PRINTER_WINDOWS_SHARE=smb://host.docker.internal/cronos_printer

# =========================================================================
# OPCIÓN B: PRODUCCIÓN EN LINUX / DIGITALOCEAN (USB DIRECTO)
# Requiere: Acceso directo al dispositivo /dev/usb/lp0 en el host
# =========================================================================
# PRINTER_CONNECTION_TYPE=linux_file
# PRINTER_FILE_PATH=/dev/usb/lp0

# =========================================================================
# OPCIÓN C: TICKETERA EN RED (ETHERNET / WI-FI)
# Para impresoras con IP fija en la red local
# =========================================================================
# PRINTER_CONNECTION_TYPE=network
# PRINTER_IP_ADDRESS=192.168.1.100
# PRINTER_PORT=9100

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
