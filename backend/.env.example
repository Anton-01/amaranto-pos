APP_NAME="Cronos POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: use service name 'postgres'. Local: use 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cronos_pos
DB_USERNAME=cronos
DB_PASSWORD=cronos_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Docker: use service name 'redis'. Local: use 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSockets)
REVERB_APP_ID=cronos-local
REVERB_APP_KEY=cronos-reverb-key
REVERB_APP_SECRET=cronos-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cronos.pos"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# QZ Tray — Impresión Directa vía WebSocket (Cliente → Ticketera)
# ==========================================================================
# La impresión ahora se procesa del lado del cliente con QZ Tray.
# El backend solo genera comandos ESC/POS en Base64 y los retorna en la API.
# La firma digital se usa para suprimir alertas de seguridad de QZ Tray.
# ==========================================================================
QZ_PRIVATE_KEY_PATH=storage/app/certs/private-key.pem
QZ_CERTIFICATE_PATH=storage/app/certs/digital-certificate.txt

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ==========================================================================
# FASE 9 — Escudo de Seguridad y Throttling
# ==========================================================================

# --- Rate Limiting -------------------------------------------------------
# Escudo global de la API: peticiones por minuto y por usuario/IP.
THROTTLE_API_MAX_ATTEMPTS=100
# Escudo de login: intentos FALLIDOS tolerados por ventana (email + IP).
THROTTLE_LOGIN_MAX_ATTEMPTS=5
# Duracion de la ventana de conteo, en segundos.
THROTTLE_LOGIN_WINDOW=60
# Bloqueo aplicado al desbordar la ventana, en segundos (15 minutos).
THROTTLE_LOGIN_LOCKOUT=900

# --- Cabeceras de Seguridad ----------------------------------------------
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
# En local conviene report_only mientras se calibra la politica.
SECURITY_CSP_REPORT_ONLY=false
# HSTS se omite automaticamente sobre http://. Forzarlo solo tras TLS.
SECURITY_HSTS_FORCE=false
SECURITY_HSTS_MAX_AGE=31536000
# Origenes extra (separados por espacio) si se suma un CDN o un agente nuevo.
SECURITY_CSP_EXTRA_SCRIPT_SRC=
SECURITY_CSP_EXTRA_CONNECT_SRC=
SECURITY_CSP_EXTRA_IMG_SRC=

# --- Cloudflare Turnstile (anti-bots del login) --------------------------
# Sin TURNSTILE_SECRET_KEY el escudo queda inactivo y el login opera solo
# con throttling. Llaves: https://dash.cloudflare.com > Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5
# false = si Cloudflare no responde, nadie entra (recomendado en un POS).
TURNSTILE_FAIL_OPEN=false

# Site key publica inyectada en el build de Vite (debe igualar TURNSTILE_SITE_KEY).
VITE_TURNSTILE_SITE_KEY=

# ==========================================================================
# FASE 10 — Telemetría de Jobs y Ecosistema de Rollback
# ==========================================================================

# --- Telemetría de jobs en segundo plano ---------------------------------
JOB_TELEMETRY_ENABLED=true
# Recorte de la traza de excepción (una traza completa ronda 30-60 KB).
JOB_TELEMETRY_MAX_TRACE=20000
# Retención del histórico. `cronos:telemetry-prune` corre a diario a las 04:15.
JOB_TELEMETRY_RETENTION_DAYS=30

# --- Bóveda AISLADA en Google Cloud Storage ------------------------------
# Requiere el adaptador (dependencia opcional, ver "suggest" en composer.json):
#   composer require league/flysystem-google-cloud-storage:^3.0
#
# El bucket vive en un proveedor DISTINTO al de la infraestructura primaria
# (DigitalOcean) a proposito: un incidente que comprometa el Droplet o el
# cluster de PostgreSQL no debe alcanzar los respaldos.
#
# Sin credenciales, BackupService degrada al disco local y lo reporta como
# estado NO aislado en el panel /admin/jobs-monitor.
GCP_PROJECT_ID=
# Ruta al JSON de la Service Account (preferida: el JSON no queda en `docker inspect`).
GCP_KEY_FILE_PATH=
# Alternativa: el JSON completo en línea, para contenedores efímeros.
GCP_KEY_FILE_JSON=
GCP_BACKUPS_BUCKET=cronos-pos-backups-isolation
GCP_BACKUPS_PREFIX=snapshots

# --- Respaldos -----------------------------------------------------------
BACKUP_DISK=gcs_backups
BACKUP_FALLBACK_DISK=backups_local

# Cifrado en reposo (AES-256-CBC + PBKDF2). NO reutilizar APP_KEY: rotarla es
# rutinario y dejaría ilegibles todos los respaldos históricos de golpe.
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

# El .env real queda FUERA del snapshot por defecto (contiene secretos).
BACKUP_INCLUDE_ENV=false

BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_AT=03:30
BACKUP_SCHEDULE_TIMEZONE=America/Mexico_City
BACKUP_DUMP_TIMEOUT=1800

# --- Rollback (recuperación ante desastres) ------------------------------
# Frase que debe teclearse completa para autorizar una restauración.
BACKUP_RESTORE_PHRASE="RESTAURAR PRODUCCION"
# Respalda el estado ACTUAL antes de sobrescribirlo. Desactivarlo vuelve
# irreversible cualquier rollback a un punto equivocado.
BACKUP_PRE_RESTORE_SNAPSHOT=true
BACKUP_RESTORE_TIMEOUT=900

# Rutas de los binarios (la imagen ya incluye postgresql-client).
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PSQL_PATH=psql

# --- Zona horaria de la sesión de PostgreSQL (corrección del desfase de 6 h) ---
# Debe coincidir con la zona de la aplicación (config/app.php). Si se deja
# vacía, se toma `app.timezone` automáticamente. Ver CONTEXT.md sección 47.
DB_TIMEZONE=
