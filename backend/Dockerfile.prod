FROM serversideup/php:8.4-fpm-alpine AS vendor

USER root

WORKDIR /app

# Solo composer.json + composer.lock: esta capa unicamente se
# invalida cuando cambian las dependencias, no el codigo fuente
COPY backend/composer.json backend/composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist \
    --ignore-platform-reqs

# ---- Stage 2: Production runtime ----
FROM serversideup/php:8.4-fpm-alpine

USER root

# Nivel Enterprise: Inyectar extensiones nativas para localización/ticketera (intl) y reportes (gd)
RUN install-php-extensions intl gd

# FASE 10 — Herramientas del ecosistema de respaldo y rollback.
#   postgresql-client -> pg_dump y psql. Sin ellos, BackupService no puede
#                        generar snapshots NI restaurarlos: la recuperacion
#                        ante desastres seria inexistente en produccion.
#   openssl           -> cifrado AES-256 en streaming del artefacto. Se usa el
#                        binario y no openssl_encrypt() de PHP porque este
#                        exige cargar el dump entero en memoria.
#   tar / gzip        -> empaquetado del snapshot (busybox no trae GNU tar).
#
# La version del cliente debe ser >= la del servidor administrado: pg_dump se
# niega a volcar una base mas nueva que el propio cliente.
RUN apk add --no-cache postgresql16-client openssl tar gzip

COPY backend/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

COPY --chown=www-data:www-data backend/ .

COPY --from=vendor --chown=www-data:www-data /app/vendor ./vendor

RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY backend/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8000 8080

USER www-data

# El ENTRYPOINT solo PREPARA (storage:link + caches) y termina en `exec "$@"`:
# el proceso de primer plano lo elige el `command:` de docker-compose.prod.yml,
# distinto para backend / reverb / scheduler / queue-worker.
#
# El CMD es solo el valor por defecto para `docker run` sin argumentos; el
# compose lo sobreescribe en los cuatro servicios. Su unica funcion aqui es que
# `exec "$@"` nunca se quede sin comando y el contenedor no salga con codigo 0.
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
