# ==============================================================
# Cronos POS — Backend Production Dockerfile
# Base pre-compilada: serversideup/php:8.4-fpm-alpine
# (pdo_pgsql, pgsql, zip, gd, intl, bcmath, opcache, redis
#  ya vienen instalados de forma nativa — cero compilacion)
# Build context: monorepo root (.)
# ==============================================================

# ---- Stage 1: Composer dependencies (capa cacheable) ----
FROM serversideup/php:8.4-fpm-alpine AS vendor

USER root

WORKDIR /app

# Solo composer.json + composer.lock: esta capa unicamente se
# invalida cuando cambian las dependencias, no el codigo fuente
COPY backend/composer.json backend/composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist \
    --ignore-platform-reqs

# ---- Stage 2: Production runtime ----
FROM serversideup/php:8.4-fpm-alpine

USER root

COPY backend/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

COPY --chown=www-data:www-data backend/ .

COPY --from=vendor --chown=www-data:www-data /app/vendor ./vendor

RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY backend/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8000 8080

USER www-data

ENTRYPOINT ["docker-entrypoint.sh"]
