# ==============================================================
# Cronos POS — Variables de Entorno de Produccion
# Copiar como .env.production en el servidor y completar valores
# ==============================================================

APP_NAME="Cronos POS"
APP_ENV=production
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://www.pos-app.tech

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================
# DigitalOcean Managed PostgreSQL
# Obtener credenciales desde: DigitalOcean > Databases > Connection Details
# ==============================================================
DB_CONNECTION=pgsql
DB_HOST=tu-cluster-db-do-user-XXXXX-0.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=cronos_pos
DB_USERNAME=cronos_app
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=TU_DOMINIO.com

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================
# Laravel Reverb (WebSockets Produccion)
# ==============================================================
REVERB_APP_ID=cronos-production
REVERB_APP_KEY=GENERAR_CLAVE_ALEATORIA_32_CHARS
REVERB_APP_SECRET=GENERAR_SECRETO_ALEATORIO_32_CHARS
REVERB_HOST=0.0.0.0
REVERB_PORT=8080

# ==============================================================
# Correo Corporativo (SMTP Produccion)
# ==============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@TU_DOMINIO.com
MAIL_PASSWORD=TU_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@TU_DOMINIO.com
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================
# QZ Tray — Firma Digital (Impresión del lado del Cliente)
# ==============================================================
QZ_PRIVATE_KEY_PATH=storage/app/certs/private-key.pem
QZ_CERTIFICATE_PATH=storage/app/certs/digital-certificate.txt

# ==============================================================
# Frontend (variables inyectadas en build)
# ==============================================================
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=pos-app.tech
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ==============================================================
# FASE 9 — Escudo de Seguridad y Throttling
# ==============================================================

# --- Rate Limiting ---
THROTTLE_API_MAX_ATTEMPTS=100
THROTTLE_LOGIN_MAX_ATTEMPTS=5
THROTTLE_LOGIN_WINDOW=60
THROTTLE_LOGIN_LOCKOUT=900

# --- Cabeceras de Seguridad ---
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# Activar solo cuando el dominio y TODOS sus subdominios sirvan HTTPS.
SECURITY_HSTS_PRELOAD=false

# --- Cloudflare Turnstile ---
# Obtener llaves en: https://dash.cloudflare.com > Turnstile > Add Site
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0xTU_SITE_KEY_PUBLICA
TURNSTILE_SECRET_KEY=0xTU_SECRET_KEY_PRIVADA
TURNSTILE_TIMEOUT=5
TURNSTILE_FAIL_OPEN=false

# Inyectada en el build de Vite (debe igualar TURNSTILE_SITE_KEY).
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"

# ==============================================================
# FASE 10 — Telemetría de Jobs y Ecosistema de Rollback
# ==============================================================

# --- Telemetría de jobs ---
JOB_TELEMETRY_ENABLED=true
JOB_TELEMETRY_MAX_TRACE=20000
JOB_TELEMETRY_RETENTION_DAYS=30

# --- Bóveda AISLADA en Google Cloud Storage ---
# 1. composer require league/flysystem-google-cloud-storage:^3.0
# 2. GCP > IAM > Service Accounts > crear cuenta con rol
#    "Storage Object Admin" LIMITADO al bucket de respaldos.
# 3. Bucket con acceso uniforme, versionado y Object Lock si es posible.
# 4. Montar el JSON como secreto y apuntar GCP_KEY_FILE_PATH.
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_KEY_FILE_PATH=/var/www/html/storage/app/certs/gcp-service-account.json
GCP_KEY_FILE_JSON=
GCP_BACKUPS_BUCKET=cronos-pos-backups-isolation
GCP_BACKUPS_PREFIX=snapshots

# --- Respaldos ---
BACKUP_DISK=gcs_backups
BACKUP_FALLBACK_DISK=backups_local
BACKUP_ENCRYPTION_ENABLED=true
# Generar con: openssl rand -base64 48
# GUARDARLA FUERA DEL SERVIDOR: sin esta llave los respaldos son irrecuperables.
BACKUP_ENCRYPTION_KEY=GENERAR_LLAVE_DEDICADA_Y_CUSTODIARLA_APARTE
BACKUP_INCLUDE_ENV=false
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_AT=03:30
BACKUP_SCHEDULE_TIMEZONE=America/Mexico_City
BACKUP_DUMP_TIMEOUT=1800

# --- Rollback ---
BACKUP_RESTORE_PHRASE="RESTAURAR PRODUCCION"
BACKUP_PRE_RESTORE_SNAPSHOT=true
BACKUP_RESTORE_TIMEOUT=900
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PSQL_PATH=psql
